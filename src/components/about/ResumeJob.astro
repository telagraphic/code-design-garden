---
import type { ResumeJob } from "@/config/resume";

type Props = {
  job: ResumeJob;
};

const { job } = Astro.props;
---

<li class="topic-list__item">
  <div class="resume__job" data-split-group>
    <div class="topic-list__body">
      <h3 class="topic-list__title" data-split-reveal>
        {job.role}
      </h3>
      <p class="topic-list__desc" data-split-reveal>
        {job.company}
      </p>
      <p class="topic-list__date topic-list__date--inline" data-split-reveal>
        {job.dates}
        {
          job.location ? (
            <>
              <span class="resume__date-sep" aria-hidden="true">
                ·
              </span>
              <span class="resume__location">{job.location}</span>
            </>
          ) : null
        }
      </p>
      <ul class="resume__highlights">
        {
          job.highlights.map((item) => (
            <li class="resume__highlight" data-split-reveal
              ><span class="resume__highlight-mark" data-reveal-with aria-hidden="true"><span>–</span></span>{item}</li>
          ))
        }
      </ul>
    </div>
    <p class="topic-list__date topic-list__date--aside" data-split-reveal>
      {job.dates}
      {
        job.location ? (
          <>
            <span class="resume__date-sep" aria-hidden="true">
              ·
            </span>
            <span class="resume__location">{job.location}</span>
          </>
        ) : null
      }
    </p>
  </div>
</li>
