---
import CommandPalette from "@cmd-kit/astro/component";
import { getPublishedAnimations } from "@/lib/animations";
import { getLiveBlogPosts } from "@/lib/blog";
import type { DocEntry } from "@/lib/docs";
import { buildSearchSectionsWithAnimations } from "@/lib/search";

interface Props {
  docs: DocEntry[];
}

const { docs } = Astro.props;
const animations = await getPublishedAnimations();
const blogPosts = await getLiveBlogPosts();
const sections = buildSearchSectionsWithAnimations(
  docs,
  animations,
  Astro.url.pathname,
  blogPosts,
);
---

<CommandPalette
  sections={sections}
  title="Search"
  shortcut="mod+k"
  messages={{ searchPlaceholder: "Search…" }}
  theme={{
    light: {
      accentColor: "#000000",
      backgroundColor: "#f9f9f9",
      textColor: "#000000",
      mutedColor: "#6b6b6b",
      borderColor: "#e0e0e0",
      overlayColor: "rgba(249, 249, 249, 0.92)",
      radius: "0.375rem",
      shadow: "0 12px 40px rgba(0, 0, 0, 0.08)",
    },
    dark: {
      accentColor: "#f9f9f9",
      backgroundColor: "#000000",
      textColor: "#f9f9f9",
      mutedColor: "#6b6b6b",
      borderColor: "#333333",
      overlayColor: "rgba(0, 0, 0, 0.85)",
      radius: "0.375rem",
      shadow: "0 12px 40px rgba(0, 0, 0, 0.4)",
    },
  }}
/>

<script is:inline>
  for (const node of document.querySelectorAll(
    'script[type="application/json"][id$="-payload"]:not([data-cmdkit-consumed="true"])',
  )) {
    if (!(node instanceof HTMLScriptElement) || !node.textContent) continue;
    try {
      const props = JSON.parse(node.textContent);
      props.reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      node.textContent = JSON.stringify(props);
    } catch {
      /* leave payload as authored */
    }
  }
</script>

<script>
  import { PAGE_ENTER_EVENT } from "@/lib/page-lifecycle";

  function setPaletteChrome(open: boolean) {
    for (const el of document.querySelectorAll(
      ".skip-link, .site-nav, main.barba-container",
    )) {
      if (el instanceof HTMLElement) el.inert = open;
    }
  }

  function bindPaletteRoot(root: Element) {
    if (!(root instanceof HTMLElement)) return;
    if (root.dataset.cmdkitA11yInit === "true") return;
    root.dataset.cmdkitA11yInit = "true";

    const overlay = root.querySelector(".cmdkit-astro-overlay");
    const input = root.querySelector(".cmdkit-astro-input");
    if (!(overlay instanceof HTMLElement)) return;

    const sync = () => {
      const open = !overlay.hidden;
      if (input instanceof HTMLInputElement) {
        input.setAttribute("aria-label", "Search");
        input.setAttribute("autocomplete", "off");
        if (open) input.focus({ preventScroll: true });
      }
      setPaletteChrome(open);
    };

    sync();
    new MutationObserver(sync).observe(overlay, {
      attributes: true,
      attributeFilter: ["hidden"],
    });
  }

  function initCmdkitA11y() {
    document.querySelectorAll(".cmdkit-astro-root").forEach(bindPaletteRoot);
  }

  function initCmdkitListScroll() {
    for (const root of document.querySelectorAll(
      ".cmdkit-astro-root:not([data-cmdkit-scroll-init])",
    )) {
      const list = root.querySelector('[data-slot="list"]');
      if (!(list instanceof HTMLElement)) continue;

      root.dataset.cmdkitScrollInit = "true";

      const scrollActiveItem = () => {
        const active = list.querySelector(
          '.cmdkit-astro-item[data-active="true"]',
        );
        if (active instanceof HTMLElement) {
          active.scrollIntoView({ block: "nearest" });
        }
      };

      const observer = new MutationObserver(() => {
        requestAnimationFrame(scrollActiveItem);
      });

      observer.observe(list, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ["data-active"],
      });
    }
  }

  initCmdkitA11y();
  initCmdkitListScroll();
  document.addEventListener(PAGE_ENTER_EVENT, () => {
    initCmdkitA11y();
    initCmdkitListScroll();
  });
</script>
