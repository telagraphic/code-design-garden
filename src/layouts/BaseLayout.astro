---
import "@/styles/global.css";
import FontFaces from "@/components/FontFaces.astro";
import SiteNav from "@/components/SiteNav.astro";
import CommandMenu from "@/components/CommandMenu.astro";
import BarbaTransitions from "@/components/BarbaTransitions.astro";
import { getAllDocs } from "@/lib/docs";
import { getNamespace } from "@/lib/barba/getNamespace";
import type { DocEntry } from "@/lib/docs";

interface Props {
  title: string;
  description?: string;
  docs?: DocEntry[];
  barbaNamespace?: string;
  pageTheme?: "light" | "dark";
}

const {
  title,
  description = "Notes on code, design, and building things on the web.",
  pageTheme = "light",
} = Astro.props;
const docs = Astro.props.docs ?? (await getAllDocs());
const barbaNamespace =
  Astro.props.barbaNamespace ?? getNamespace(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteName = "My Website For This";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    <title>{title} — {siteName}</title>
    <FontFaces />
  </head>
  <body data-barba="wrapper">
    <div data-transition-wrap class="transition" aria-hidden="true">
      <template data-transition-shutter-template>
        <div data-transition-shutter class="transition__shutter"></div>
      </template>
      <template data-transition-pixel-template>
        <div data-transition-col class="transition__col">
          <div data-transition-pixel class="transition__pixel"></div>
        </div>
      </template>
      <template data-transition-sliding-column-template>
        <div data-transition-column class="transition__column"></div>
      </template>
      <div data-transition-panel class="transition__panel"></div>
    </div>

    <a class="skip-link" href="#introduction">Skip to content</a>
    <SiteNav />

    <main
      data-barba="container"
      data-barba-namespace={barbaNamespace}
      data-page-theme={pageTheme}
      class="barba-container"
      tabindex="-1"
    >
      <slot />
    </main>

    <CommandMenu docs={docs} />
    <BarbaTransitions />
  </body>
</html>
