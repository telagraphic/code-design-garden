---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getLiveBlogPosts,
  getRecentBlogLinks,
  postsPath,
} from "@/lib/blog";
import { postsLabel } from "@/lib/nav";

const livePosts = await getLiveBlogPosts();
const recentLinks = getRecentBlogLinks(livePosts, 5);
const showViewAll = livePosts.length > 5;
---

<BaseLayout title={postsLabel} barbaNamespace="blog">
  <div class="blog-home">
    <div class="blog-column blog-column--solo">
    <h1 id="introduction" class="blog-home__label" tabindex="-1">{postsLabel}</h1>

    {
      recentLinks.length > 0 ? (
        <>
          <ul class="topic-list topic-list--compact">
            {recentLinks.map((link) => (
              <li class="topic-list__item">
                <a class="topic-list__link" href={link.href}>
                  <span class="topic-list__body">
                    <h2 class="topic-list__title">{link.title}</h2>
                    <p class="topic-list__desc">{link.desc}</p>
                  </span>
                  <p class="topic-list__date">{link.date}</p>
                </a>
              </li>
            ))}
          </ul>
          {
            showViewAll && (
              <a class="blog-home__view-all" href={postsPath}>
                View all posts →
              </a>
            )
          }
        </>
      ) : (
        <p class="landing-content__muted">No posts yet.</p>
      )
    }
    </div>
  </div>
</BaseLayout>
