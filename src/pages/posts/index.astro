---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPubDate, getBlogPath, getLiveBlogPosts } from "@/lib/blog";
import { postsLabel } from "@/lib/nav";

const livePosts = await getLiveBlogPosts();
---

<BaseLayout title={postsLabel} barbaNamespace="blog">
  <div class="blog-home">
    <div class="blog-column blog-column--solo">
      <h1 id="introduction" class="blog-home__label" tabindex="-1">
        {postsLabel}
      </h1>

      {
        livePosts.length > 0 ? (
          <ul class="topic-list topic-list--compact">
            {livePosts.map((post) => (
              <li class="topic-list__item">
                <a class="topic-list__link" href={getBlogPath(post)}>
                  <span class="topic-list__body">
                    <h2 class="topic-list__title">{post.data.title}</h2>
                    <p class="topic-list__desc">{post.data.description}</p>
                  </span>
                  <p class="topic-list__date">
                    {formatPubDate(post.data.pubDate)}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="landing-content__muted">No posts yet.</p>
        )
      }
    </div>
  </div>
</BaseLayout>
