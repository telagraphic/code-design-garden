---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AboutIntro from "@/components/about/AboutIntro.astro";
import ResumeJob from "@/components/about/ResumeJob.astro";
import { resumeJobs } from "@/config/resume";
---

<BaseLayout
  title="About"
  description="What this site is for — notes on code, design, and building things on the web."
  barbaNamespace="about"
>
  <noscript>
    <style>
      [data-split-reveal] {
        visibility: visible !important;
      }
    </style>
  </noscript>
  <div class="blog-home">
    <div class="blog-column blog-column--solo">
      <AboutIntro />

      <section class="resume" aria-labelledby="resume-heading">
        <h2
          id="resume-heading"
          class="blog-home__label"
          data-split-group
          data-split-reveal
        >
          Experience
        </h2>
        <ul class="topic-list topic-list--spacious">
          {resumeJobs.map((job) => <ResumeJob job={job} />)}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
