# Animation library (local / Docker only)
# Auto-detects when media/animations/previews contains mp4 files.
# Leave UNSET on Netlify so the gallery stays off without preview media.
# PUBLIC_ANIMATION_LIBRARY_ENABLED=true
# PUBLIC_ANIMATION_LIBRARY_ENABLED=false

# Public site URL (optional; Netlify sets URL automatically during build)
# PUBLIC_SITE_URL=https://my-website-for-this.netlify.app

# Archived Osmo/MWG sources (for migrate scripts)
# ANIMATION_OSMO_ARCHIVE=~/Archive/code-design-garden-osmo
# ANIMATION_MWG_ARCHIVE=~/Archive/code-design-garden-mwg

# Bunny Stream CDN pull zone (no trailing slash)
# PUBLIC_BUNNY_VIDEO_BASE_URL=https://vz-xxxx.b-cdn.net

# Bunny fonts pull zone (no trailing slash). When set, @font-face URLs
# resolve here instead of /fonts/… — upload the same relative paths as public/fonts.
# PUBLIC_BUNNY_FONT_BASE_URL=https://code-design-garden.b-cdn.net/fonts

# Bunny Storage (local upload script only — never commit real keys; never set on Netlify)
# BUNNY_STORAGE_ZONE=code-design-garden
# BUNNY_STORAGE_ACCESS_KEY=
# BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com
# PUBLIC_BUNNY_IMAGE_BASE_URL=https://code-design-garden.b-cdn.net
